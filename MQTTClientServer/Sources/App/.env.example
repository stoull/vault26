# !!! WARNING !!!
# CAN NOT USE Chinese Characters for Hummingbird with Environment.dotEnv() function.


# MQTT Server Config
MQTT_HOST=macmini.local
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password

# MariaDB Config
DB_HOST=macmini.local
DB_PORT=3306
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=test

# Optional HTTPS (PEM). If both are set, Hummingbird serves TLS on HTTP_PORT (default 8044).
TLS_CERT_PATH=/path/to/vault26/certs/cert.pem
TLS_KEY_PATH=/path/to/vault26/certs/key.pem
HTTP_PORT=8044

# for testing
TEST_DB_DATABASE=your_db_for_test
# fixed or isolated (optional, default is fixed)
# fixed: Use the specified fixed test database
# isolated: Automatically create a unique temporary database for each test case and delete it after the test finishes, using TEST_DB_DATABASE as the database name prefix
TEST_DB_MODE=isolated
TEST_DB_HOST=macmini.local
TEST_DB_PORT=3306
TEST_DB_USERNAME=your_test_username
TEST_DB_PASSWORD=your_test_password
# Only used in isolated mode, it's optional, default is mysql
TEST_DB_ADMIN_DATABASE=test